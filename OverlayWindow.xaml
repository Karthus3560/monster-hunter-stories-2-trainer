<Window x:Class="RidersToolkit.OverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Kinship Studio · Quick controls" Width="440" Height="650" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False" Background="{DynamicResource Canvas}" Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual" UseLayoutRounding="True" PreviewKeyDown="OnOverlayKey">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Bool"/>
    <Style x:Key="OverlayTab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,5,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Tab" CornerRadius="0" Background="{DynamicResource Raised}" Padding="10,8"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource Selected}"/><Setter Property="Foreground" Value="{DynamicResource Mint}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource RoseSurface}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Gold}"/><Setter TargetName="Tab" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="OverlayFeature">
      <Border CornerRadius="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="11,10" Margin="0,0,5,7" ToolTip="{Binding Description}">
        <StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource Mint}" FontSize="15" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/></StackPanel>
            <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding Active, Mode=OneWay}" IsEnabled="{Binding Available}" Click="OnToggle" AutomationProperties.Name="{Binding Title}" VerticalAlignment="Center"/>
          </Grid>
          <Grid Margin="28,6,0,0" Visibility="{Binding IsSlider, Converter={StaticResource Bool}}"><Grid.ColumnDefinitions><ColumnDefinition Width="49"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding MultiplierLabel}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Mint}" VerticalAlignment="Center"/>
            <Slider Grid.Column="1" Style="{StaticResource MultiplierSlider}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Multiplier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TickFrequency="{Binding SliderStep}" SmallChange="{Binding SliderStep}" LargeChange="1" IsSnapToTickEnabled="True" Margin="3,0,8,0" AutomationProperties.Name="{Binding Title}"/>
            <Button Grid.Column="2" Content="Reset" Padding="9,4" MinHeight="30" FontSize="11" Click="OnReset" AutomationProperties.Name="{Binding Title, StringFormat={}Reset {0}}"/>
          </Grid>
          <ComboBox ItemsSource="{Binding ChoiceOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Target,Mode=TwoWay}" Visibility="{Binding IsChoice, Converter={StaticResource Bool}}" Margin="28,8,0,0" HorizontalAlignment="Left" MinWidth="210" AutomationProperties.Name="Prayer Pot effect"/>
          <ComboBox ItemsSource="{Binding LootOptions}" SelectedItem="{Binding Target, Mode=TwoWay}" Visibility="{Binding IsLoot, Converter={StaticResource Bool}}" Margin="28,8,0,0" Width="140" HorizontalAlignment="Left" AutomationProperties.Name="Loot multiplier"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0}× loot}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
          <Grid Margin="28,8,0,0"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="{Binding IsNumeric, Converter={StaticResource Bool}}"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.Category, RelativeSource={RelativeSource AncestorType=Window}}" Value="Quick"/><Condition Binding="{Binding DataContext.Search, RelativeSource={RelativeSource AncestorType=Window}}" Value=""/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Current, StringFormat={}Now  {0}}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="8,5" MinHeight="30" AutomationProperties.Name="{Binding Title, StringFormat={}Target for {0}}"/>
            <Button Grid.Column="2" Content="Set" Padding="11,4" MinHeight="30" Margin="6,0,0,0" FontSize="11" IsEnabled="{Binding Bound}" Click="OnApply"/>
          </Grid>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Border Background="{DynamicResource OverlaySurface}" BorderBrush="{DynamicResource Line}" BorderThickness="3" CornerRadius="0" Margin="0" Padding="15,12,10,12">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Background="Transparent" MouseLeftButtonDown="OnDrag" Margin="0,0,5,10"><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Image x:Name="NavirouImage" AutomationProperties.Name="Pixel Navirou face" Source="pack://application:,,,/RidersToolkit;component/Assets/navirou-pixel-v33.png" Width="40" Height="40" Stretch="Uniform" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Kinship Studio" FontSize="15" FontWeight="SemiBold" FontFamily="{StaticResource PixelFont}"/><TextBlock Text="ALT + W  ·  Pinned camp controls" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/></StackPanel>
        <Button Grid.Column="2" x:Name="DismissButton" Content="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Width="32" MinHeight="32" Padding="0" VerticalAlignment="Center" Click="OnDismiss" ToolTip="Back to game · Esc or Alt+W" AutomationProperties.Name="Close overlay and return to game"/>
      </Grid>
      <Grid Grid.Row="1" Margin="2,0,6,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Session.ConnectionStatus}" Foreground="{DynamicResource Mint}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Session.ActiveCount, StringFormat={}{0} active}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="12,0,0,0"/></Grid>
      <StackPanel Grid.Row="2" Margin="0,0,5,10">
        <WrapPanel Margin="0,0,0,9"><RadioButton Content="Quick" Tag="Quick" GroupName="Pages" Style="{StaticResource OverlayTab}" IsChecked="True" Checked="OnCategory"/><RadioButton Content="Battle" Tag="Battle" GroupName="Pages" Style="{StaticResource OverlayTab}" Checked="OnCategory"/><RadioButton Content="Explore" Tag="Exploration" GroupName="Pages" Style="{StaticResource OverlayTab}" Checked="OnCategory"/><RadioButton Content="Move" Tag="Movement" GroupName="Pages" Style="{StaticResource OverlayTab}" Checked="OnCategory"/><RadioButton Content="Items" Tag="Inventory" GroupName="Pages" Style="{StaticResource OverlayTab}" Checked="OnCategory"/></WrapPanel>
        <Grid><TextBox x:Name="OverlaySearch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="9,6" MinHeight="32" AutomationProperties.Name="Search overlay controls" ToolTip="Search every trainer control · Ctrl+K"/><TextBlock Text="Search all controls…  Ctrl+K" FontSize="11" Foreground="{DynamicResource Muted}" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
      </StackPanel>
      <ScrollViewer Grid.Row="3" x:Name="OverlayScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding Session.NotBusy}"><StackPanel>
        <ItemsControl x:Name="OverlayItems" ItemsSource="{Binding Controls}" ItemTemplate="{StaticResource OverlayFeature}"/>
        <TextBlock Text="No matching controls. Try another search." Foreground="{DynamicResource Muted}" FontSize="12" Margin="3,12,5,15"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Controls.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </StackPanel></ScrollViewer>
      <TextBlock Grid.Row="4" Text="{Binding Session.Notice}" FontSize="10" Foreground="{DynamicResource Muted}" Margin="2,8,7,9" MaxHeight="30" TextTrimming="CharacterEllipsis" ToolTip="{Binding Session.Notice}"/>
      <TextBlock Grid.Row="6" Text="By Ghaith Saad Jawad" Foreground="{DynamicResource Muted}" FontSize="10" HorizontalAlignment="Center" Margin="0,8,5,0" AutomationProperties.Name="Created by Ghaith Saad Jawad"/>
      <Grid Grid.Row="5" Margin="0,0,5,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Back to game   Esc" FontSize="11" Padding="9,7" Click="OnDismiss"/><Button Grid.Column="1" Content="Stop all   F12" Foreground="{DynamicResource Red}" Background="{DynamicResource DangerSurface}" BorderBrush="{DynamicResource DangerLine}" FontSize="11" Padding="12,7" Margin="8,0,0,0" Click="OnStop"/></Grid>
    </Grid>
  </Border>
</Window>
