<Window x:Class="KinshipLauncher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore" Title="Kinship Studio — Stories 2" Width="1040" Height="750" MinWidth="900" MinHeight="710" WindowStartupLocation="CenterScreen" Background="#10232C" Foreground="#EDE8DB">
 <Grid Background="#10232C"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border BorderBrush="#2C4650" BorderThickness="0,0,1,0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#233D46"/><GradientStop Color="#10242D" Offset="1"/></LinearGradientBrush></Border.Background>
   <Grid Margin="28,34,28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="KINSHIP" FontFamily="Georgia" FontSize="30" Foreground="{StaticResource Gold}"/><TextBlock Text="S T U D I O" FontSize="17" Margin="2,4,0,0"/><Border Width="36" Height="2" Background="{StaticResource Gold}" HorizontalAlignment="Left" Margin="2,22,0,0"/></StackPanel>
    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,36"><Grid Width="174" Height="174" HorizontalAlignment="Center"><Ellipse Stroke="#49616A" StrokeThickness="1" Margin="3"/><Ellipse Stroke="#8E7957" StrokeThickness="1" Margin="16"/><Rectangle Fill="{StaticResource Gold}" Margin="24"><Rectangle.OpacityMask><ImageBrush ImageSource="Assets/emblem.png" Stretch="Uniform"/></Rectangle.OpacityMask></Rectangle></Grid><TextBlock Text="A bond worth building." FontFamily="Georgia" FontSize="18" TextAlignment="Center" Margin="0,24,0,8"/><TextBlock Text="Your adventure.&#10;Your way to play." Foreground="{StaticResource Muted}" TextAlignment="Center" LineHeight="23"/></StackPanel>
    <StackPanel Grid.Row="2"><TextBlock Text="STORIES 2 EDITION" FontSize="11" Foreground="{StaticResource Gold}"/><TextBlock Text="Created by Ghaith Saad Jawad" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/><TextBlock Text="Launcher 1.1.0" FontSize="11" Foreground="#849EA3" Margin="0,5,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="38,29,38,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="MONSTER HUNTER STORIES 2" Foreground="{StaticResource Gold}" FontSize="12"/><TextBlock Text="Ready for the next hunt." FontFamily="Georgia" FontSize="30" Margin="0,10,0,7"/><TextBlock Text="Launch your adventure with Kinship Studio in the Camp menu." Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="23"/></StackPanel>
   <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="#35515B" BorderThickness="1" CornerRadius="12" Margin="0,25,0,19" Padding="20,17"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="GameBadge" Text="Finding your game…" FontFamily="Segoe UI Semibold" FontSize="15"/><TextBlock x:Name="GamePath" Text="Checking your Steam libraries" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,8,14,0" ToolTipService.ShowDuration="20000"/></StackPanel><Button x:Name="BrowseButton" Grid.Column="1" Content="Browse…" Click="BrowseClick" AutomationProperties.Name="Choose the Stories 2 game folder" VerticalAlignment="Center" Padding="16,8"/></Grid></Border>
   <StackPanel Grid.Row="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="PlayButton" Content="Play with Studio" Click="PlayClick" FontSize="17" MinHeight="56" Background="{StaticResource Gold}" Foreground="#142A32" BorderBrush="#F0D6A5" IsEnabled="False"/><Button x:Name="VanillaButton" Grid.Column="1" Content="Game only" Click="VanillaClick" Margin="12,0,0,0" MinWidth="112" IsEnabled="False"/></Grid><TextBlock Text="Starts through Steam. Your saved options stay with you." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel>
   <Border Grid.Row="3" BorderBrush="#304B55" BorderThickness="1" CornerRadius="12" Margin="0,24,0,18" Padding="21,18" VerticalAlignment="Top"><StackPanel>
    <TextBlock Text="YOUR LAUNCH" FontSize="11" Foreground="#B4C6C6" Margin="0,0,0,13"/>
    <Grid Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Step0" Background="#284650" CornerRadius="14" Width="27" Height="27" HorizontalAlignment="Left"><TextBlock x:Name="Mark0" Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Border><TextBlock Grid.Column="1" Text="Find your game" VerticalAlignment="Center"/></Grid>
    <Grid Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Step1" Background="#284650" CornerRadius="14" Width="27" Height="27" HorizontalAlignment="Left"><TextBlock x:Name="Mark1" Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Border><TextBlock Grid.Column="1" Text="Start Stories 2 normally" VerticalAlignment="Center"/></Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Step2" Background="#284650" CornerRadius="14" Width="27" Height="27" HorizontalAlignment="Left"><TextBlock x:Name="Mark2" Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Border><TextBlock Grid.Column="1" Text="Bring Studio into the game" VerticalAlignment="Center"/></Grid>
    <Border Height="1" Background="#304B55" Margin="0,17,0,13"/>
    <TextBlock x:Name="Status" Text="Looking for a supported installation…" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="13" LineHeight="20" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel></Border>
   <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Settings, profiles and backups live inside Studio." FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/><Button Grid.Column="1" Content="Help / logs" Click="HelpClick" Background="Transparent" BorderThickness="0" Foreground="#D4C29F" Padding="12,8" FontSize="12"/></Grid>
  </Grid>
 </Grid>
</Window>
