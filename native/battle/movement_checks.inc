void movementChecks(){
 using namespace battle;
 const auto oldImage=image;
 auto world=reinterpret_cast<uintptr_t>(VirtualAlloc(nullptr,0x2000000,MEM_COMMIT|MEM_RESERVE,PAGE_READWRITE));
 require(world!=0,"allocate isolated movement world");image=world;
 auto putQ=[](uintptr_t a,uintptr_t v){*reinterpret_cast<uintptr_t*>(a)=v;};
 auto putI=[](uintptr_t a,int v){*reinterpret_cast<int*>(a)=v;};
 auto putF=[](uintptr_t a,float v){*reinterpret_cast<float*>(a)=v;};
 auto getF=[](uintptr_t a){return *reinterpret_cast<float*>(a);};
 auto manager=world+0x1000,table=world+0x2000,rows=world+0x3000,row=world+0x4000;
 putQ(world+0x1debc10,manager);putQ(manager,world+0x100);
 putQ(manager+0x300,table);putQ(table,world+0x100);putI(table+0xd0,1);putQ(table+0xe0,rows);putQ(rows,row);putQ(row,world+0x175b900);
 for(unsigned field:{0x18u,0x1cu,0x20u})putF(row+field,2.f);
 settings[10]=2;movementTable(10,0x300,0x175b900,{0x18,0x1c,0x20});
 require(getF(row+0x18)==3.f&&getF(row+0x1c)==3.f&&getF(row+0x20)==3.f,"walking multiplier reaches all three speed fields");
 for(int i=0;i<30;++i)movementTable(10,0x300,0x175b900,{0x18,0x1c,0x20});
 require(getF(row+0x18)==3.f,"walking maintenance never compounds");
 settings[10]=8;movementTable(10,0x300,0x175b900,{0x18,0x1c,0x20});require(getF(row+0x18)==6.f,"walking slider edit retains original baseline");
 restore(10);require(getF(row+0x18)==2.f,"walking restore returns original speeds");
 settings[10]=2;putQ(row,world+0x175b728);movementTable(10,0x300,0x175b900,{0x18});require(getF(row+0x18)==2.f,"wrong movement row type is rejected");
 putQ(manager+0x308,table);for(unsigned field:{0x40u,0x44u,0x5cu})putF(row+field,3.f);
 settings[11]=4;movementTable(11,0x308,0x175b728,{0x40,0x44,0x5c});require(getF(row+0x40)==6.f&&getF(row+0x5c)==6.f,"mounted speed includes Dash");
 putQ(rows,0);restore(11);require(getF(row+0x40)==6.f,"replaced table row is never restored through stale owner");putQ(rows,row);
 putQ(row,world+0x175b9c0);putQ(manager+0x318,table);putF(row+0x38,2.f);putF(row+0x3c,4.f);settings[13]=8;
 movementTable(13,0x318,0x175b9c0,{0x38,0x3c});require(getF(row+0x38)==6.f&&getF(row+0x3c)==12.f,"swimming speed uses both native fields");restore(13);
 putI(table+0xd0,257);movementTable(13,0x318,0x175b9c0,{0x38});require(getF(row+0x38)==2.f,"oversized movement table is rejected");
 auto save=world+0x100000,player=world+0x160000,state=world+0x180000,controller=world+0x1a0000;
 auto vt=world+0x1b0000,fn=world+0x1b1000,metadata=world+0x1b2000,name=world+0x1b3000;
 putQ(world+0x1db2eb0,save);putQ(save,world+0x100);putQ(save+0x33398,player);putQ(player,world+0x100);
 putQ(player+0x4890,state);putQ(state,world+0x100);putQ(player+0x4888,controller);putQ(controller,vt);putQ(vt+0x20,fn);
 unsigned char code[]{0x48,0x8d,0x05,0,0,0,0,0xc3};int displacement=static_cast<int>(metadata-fn-7);memcpy(code+3,&displacement,4);memcpy(reinterpret_cast<void*>(fn),code,8);putQ(metadata+8,name);memcpy(reinterpret_cast<void*>(name),"cPlCtrlAirRideTest",18);
 putQ(controller+0xd968,state);putF(state+0x148,12.f);settings[12]=4;settings[14]=2;inBattle=false;
 for(int i=0;i<7;++i)putF(state+0x250+i*4,2.f);
 movement();require(getF(state+0x148)==24.f,"flight speed applies only to verified air controller");
 bool allEgg=true;for(int i=0;i<7;++i)allEgg&=getF(state+0x250+i*4)==3.f;require(allEgg,"egg carrying scales all seven native speeds");
 for(int i=0;i<30;++i)movement();require(getF(state+0x148)==24.f&&getF(state+0x250)==3.f,"flight and egg maintenance never compound");
 restore(12);putQ(controller+0xd968,0);movement();require(getF(state+0x148)==12.f,"flight rejects mismatched common-data owner");putQ(controller+0xd968,state);
 *reinterpret_cast<char*>(name)='X';movement();require(getF(state+0x148)==12.f,"flight rejects non-air controller type");*reinterpret_cast<char*>(name)='c';
 inBattle=true;movement();require(getF(state+0x250)==2.f,"egg carrying speed restores on battle entry");
 stop();require(getF(state+0x148)==12.f&&saved.empty(),"stop all restores movement captures");
 VirtualFree(reinterpret_cast<void*>(world),0,MEM_RELEASE);image=oldImage;
}
