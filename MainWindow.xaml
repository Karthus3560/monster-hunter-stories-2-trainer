<Window x:Class="RidersToolkit.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RidersToolkit" Style="{StaticResource {x:Type Window}}" Icon="navirou-pixel-v33.ico" Title="Kinship Studio · Stories 2" Width="1020" Height="730" MinWidth="760" MinHeight="480" WindowStartupLocation="Manual" Closing="OnClosing" UseLayoutRounding="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Bool"/>
    <local:FeatureCardWidthConverter x:Key="CardWidth"/>
    <Style x:Key="BattleTab" TargetType="Button" BasedOn="{StaticResource Nav}"><Style.Triggers><DataTrigger Binding="{Binding PageTitle}" Value="Battle controls"><Setter Property="Background" Value="{DynamicResource SideSelected}"/><Setter Property="Foreground" Value="{DynamicResource SideInk}"/><Setter Property="BorderBrush" Value="#82D9CE"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="InventoryTab" TargetType="Button" BasedOn="{StaticResource Nav}"><Style.Triggers><DataTrigger Binding="{Binding PageTitle}" Value="Inventory controls"><Setter Property="Background" Value="{DynamicResource SideSelected}"/><Setter Property="Foreground" Value="{DynamicResource SideInk}"/><Setter Property="BorderBrush" Value="#82D9CE"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="ExplorationTab" TargetType="Button" BasedOn="{StaticResource Nav}"><Style.Triggers><DataTrigger Binding="{Binding PageTitle}" Value="Exploration controls"><Setter Property="Background" Value="{DynamicResource SideSelected}"/><Setter Property="Foreground" Value="{DynamicResource SideInk}"/><Setter Property="BorderBrush" Value="#82D9CE"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="MovementTab" TargetType="Button" BasedOn="{StaticResource Nav}"><Style.Triggers><DataTrigger Binding="{Binding PageTitle}" Value="Movement controls"><Setter Property="Background" Value="{DynamicResource SideSelected}"/><Setter Property="Foreground" Value="{DynamicResource SideInk}"/><Setter Property="BorderBrush" Value="#82D9CE"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="LuckTab" TargetType="Button" BasedOn="{StaticResource Nav}"><Style.Triggers><DataTrigger Binding="{Binding PageTitle}" Value="Hunt &amp; workshop"><Setter Property="Background" Value="{DynamicResource SideSelected}"/><Setter Property="Foreground" Value="{DynamicResource SideInk}"/><Setter Property="BorderBrush" Value="#82D9CE"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="BackupsTab" TargetType="Button" BasedOn="{StaticResource Nav}"><Style.Triggers><DataTrigger Binding="{Binding PageTitle}" Value="Save backups"><Setter Property="Background" Value="{DynamicResource SideSelected}"/><Setter Property="Foreground" Value="{DynamicResource SideInk}"/><Setter Property="BorderBrush" Value="#82D9CE"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="ProfilesTab" TargetType="Button" BasedOn="{StaticResource Nav}"><Style.Triggers><DataTrigger Binding="{Binding PageTitle}" Value="Profiles &amp; hotkeys"><Setter Property="Background" Value="{DynamicResource SideSelected}"/><Setter Property="Foreground" Value="{DynamicResource SideInk}"/><Setter Property="BorderBrush" Value="#82D9CE"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="ResearchTab" TargetType="Button" BasedOn="{StaticResource Nav}"><Style.Triggers><DataTrigger Binding="{Binding PageTitle}" Value="Egg &amp; gene studio"><Setter Property="Background" Value="{DynamicResource SideSelected}"/><Setter Property="Foreground" Value="{DynamicResource SideInk}"/><Setter Property="BorderBrush" Value="#82D9CE"/></DataTrigger></Style.Triggers></Style>
    <DataTemplate x:Key="FeatureTemplate">
      <Border Style="{StaticResource Surface}" Padding="14,12" Margin="0,0,8,8">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource Selected}" CornerRadius="0" Width="28" Height="28" VerticalAlignment="Top"><TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Mint}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Grid.Column="1" Margin="6,0,12,0"><TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" FontSize="12" MinHeight="32" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding Hotkey}" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Top" Margin="0,7,12,0"/>
            <ToggleButton Grid.Column="3" Style="{StaticResource Switch}" IsChecked="{Binding Active, Mode=OneWay}" Click="OnToggleFeature" IsEnabled="{Binding Available}" VerticalAlignment="Top" AutomationProperties.Name="{Binding Title}" ToolTip="Switch on; applies when the game is ready"/>
          </Grid>
          <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource Mint}" Margin="40,5,0,0" Visibility="{Binding Active, Converter={StaticResource Bool}}"/>
          <ComboBox ItemsSource="{Binding ChoiceOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Target,Mode=TwoWay}" Visibility="{Binding IsChoice, Converter={StaticResource Bool}}" Margin="40,8,0,0" HorizontalAlignment="Left" MinWidth="210" AutomationProperties.Name="Prayer Pot effect"/>
          <ComboBox ItemsSource="{Binding LootOptions}" SelectedItem="{Binding Target, Mode=TwoWay}" Visibility="{Binding IsLoot, Converter={StaticResource Bool}}" Margin="40,8,0,0" HorizontalAlignment="Left" Width="150" AutomationProperties.Name="Loot multiplier"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0}× loot}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
          <Grid Margin="40,5,0,0" Visibility="{Binding IsSlider, Converter={StaticResource Bool}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding MultiplierLabel}" FontSize="18" FontFamily="{StaticResource PixelFont}" FontWeight="SemiBold" Foreground="{DynamicResource Mint}" VerticalAlignment="Center"/>
            <Slider Grid.Column="1" Style="{StaticResource MultiplierSlider}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Multiplier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TickFrequency="{Binding SliderStep}" SmallChange="{Binding SliderStep}" LargeChange="1" IsSnapToTickEnabled="True" Margin="8,0,12,0" AutomationProperties.Name="{Binding Title}" ToolTip="Adjust with arrow keys; switch on to apply"/>
            <Button Grid.Column="2" Content="Reset" Click="OnResetMultiplier" Padding="10,5" ToolTip="Switch off and restore normal values"/>
          </Grid>
          <Grid Margin="40,8,0,0" Visibility="{Binding IsNumeric, Converter={StaticResource Bool}}">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Current  " Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/><TextBlock Text="{Binding Current}" FontSize="16" FontWeight="SemiBold"/></StackPanel>
            <TextBox Grid.Column="1" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Target value" ToolTip="Value to apply or maintain"/>
            <Button Grid.Column="2" Content="Set" Margin="7,0,0,0" Padding="14,5" Click="OnApplyFeature" IsEnabled="{Binding Bound}" ToolTip="Apply once"/>
          </Grid>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid Background="{DynamicResource Canvas}">
    <Grid.RowDefinitions><RowDefinition/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource SideLine}" BorderThickness="0,0,1,0">
      <Grid Margin="12,15,12,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,10"><Button Style="{StaticResource SidebarAction}" x:Name="MascotCard" Click="OnMascotTap" ToolTip="Navirou’s tips · click me" AutomationProperties.Name="Navirou's shortcut tips" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SideInk}" Padding="0,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="Assets/navirou-pixel-v33.png" Width="44" Height="44" Stretch="Uniform" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="Pixel Navirou, your hunting companion"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0"><TextBlock Text="Kinship" FontFamily="{StaticResource PixelFont}" FontSize="17"/><TextBlock Text="Studio" FontFamily="{StaticResource PixelFont}" FontSize="17" Foreground="#82D9CE"/></StackPanel></Grid></Button><TextBlock Text="Stories 2 companion · v3.5" TextAlignment="Center" FontSize="10" Foreground="{DynamicResource SideMuted}" Margin="0,5,0,9"/><Border x:Name="CoastScene" BorderBrush="{DynamicResource SideLine}" BorderThickness="2" Height="96" ClipToBounds="True"><Image Source="Assets/hakolo-coast-v34.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="Pixel-art coastal camp with a Felyne and Rathalos"/></Border></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
          <Button Style="{StaticResource BattleTab}" Tag="Battle" Click="OnNavigate" AutomationProperties.Name="Battle controls"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{StaticResource PixelBattle}" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.EdgeMode="Aliased"/><TextBlock Grid.Column="1" Text="{Binding BattleNav}" FontSize="12" TextWrapping="NoWrap"/></Grid></Button>
          <Button Style="{StaticResource InventoryTab}" Tag="Inventory" Click="OnNavigate" AutomationProperties.Name="Inventory controls"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{StaticResource PixelInventory}" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.EdgeMode="Aliased"/><TextBlock Grid.Column="1" Text="{Binding InventoryNav}" FontSize="12" TextWrapping="NoWrap"/></Grid></Button>
          <Button Style="{StaticResource ExplorationTab}" Tag="Exploration" Click="OnNavigate" AutomationProperties.Name="Exploration controls"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{StaticResource PixelExploration}" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.EdgeMode="Aliased"/><TextBlock Grid.Column="1" Text="{Binding ExplorationNav}" FontSize="12" TextWrapping="NoWrap"/></Grid></Button>
          <Button Style="{StaticResource MovementTab}" Tag="Movement" Click="OnNavigate" AutomationProperties.Name="Movement controls"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{StaticResource PixelMovement}" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.EdgeMode="Aliased"/><TextBlock Grid.Column="1" Text="{Binding MovementNav}" FontSize="12" TextWrapping="NoWrap"/></Grid></Button>
          <Border Height="1" Background="{DynamicResource SideLine}" Margin="10,9"/>
          <Button Style="{StaticResource LuckTab}" Tag="Luck" Click="OnNavigate" AutomationProperties.Name="Hunt &amp; workshop"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{StaticResource PixelLuck}" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.EdgeMode="Aliased"/><TextBlock Grid.Column="1" Text="Hunt &amp; workshop" FontSize="12" TextWrapping="NoWrap"/></Grid></Button>
          <Button Style="{StaticResource BackupsTab}" Tag="Backups" Click="OnNavigate" AutomationProperties.Name="Save backups"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{StaticResource PixelBackups}" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.EdgeMode="Aliased"/><TextBlock Grid.Column="1" Text="Save backups" FontSize="12" TextWrapping="NoWrap"/></Grid></Button>
          <Button Style="{StaticResource ProfilesTab}" Tag="Profiles" Click="OnNavigate" AutomationProperties.Name="Profiles &amp; hotkeys"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{StaticResource PixelProfiles}" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.EdgeMode="Aliased"/><TextBlock Grid.Column="1" Text="Profiles &amp; hotkeys" FontSize="12" TextWrapping="NoWrap"/></Grid></Button>
          <Button Style="{StaticResource ResearchTab}" Tag="Research" Click="OnNavigate" AutomationProperties.Name="Egg &amp; gene studio"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{StaticResource PixelResearch}" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.EdgeMode="Aliased"/><TextBlock Grid.Column="1" Text="Egg &amp; gene studio" FontSize="11" TextWrapping="NoWrap"/></Grid></Button>

        </StackPanel></ScrollViewer>
        <StackPanel Grid.Row="2" Margin="2,9,2,0"><Button Style="{StaticResource SidebarAction}" Content="Quick overlay   Alt+W" Click="OnOpenOverlay" Foreground="{DynamicResource SideInk}" Background="{DynamicResource SideRaised}" BorderBrush="{DynamicResource SideLine}" FontSize="11" Padding="8,5" MinHeight="29" Margin="0,0,0,6"/><Button Style="{StaticResource SidebarAction}" x:Name="BorderlessButton" Content="Borderless fullscreen" Click="OnBorderlessGame" Foreground="{DynamicResource SideInk}" Background="{DynamicResource SideRaised}" BorderBrush="{DynamicResource SideLine}" FontSize="11" Padding="8,5" MinHeight="29" Margin="0,0,0,6" ToolTip="Set Stories 2 to Windowed first. Click to fill the monitor; click again to restore."/><CheckBox Content="Always on top" Foreground="{DynamicResource SideMuted}" IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" Margin="3,2,0,7"/><Button Style="{StaticResource SidebarAction}" Content="Disable all     F12" Click="OnStopAll" Foreground="{DynamicResource SideDangerInk}" Background="{DynamicResource SideDangerSurface}" BorderBrush="{DynamicResource SideLine}" FontSize="12" Padding="8,5" MinHeight="30"/><Button Style="{StaticResource SidebarAction}" x:Name="ThemeButton" Content="Theme: Stories light" Click="OnThemeChange" Foreground="{DynamicResource SideMuted}" Background="Transparent" BorderThickness="0" FontSize="11" MinHeight="25" Padding="4,3" Margin="0,5,0,0" AutomationProperties.Name="Change app theme" ToolTip="Switch Stories light and Moonlit hunt; your choice is remembered"/><TextBlock Text="By Ghaith Saad Jawad" TextAlignment="Center" Foreground="{DynamicResource SideMuted}" FontSize="10" Margin="0,3,0,0" AutomationProperties.Name="Created by Ghaith Saad Jawad"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="20,16,12,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,8,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding PageTitle}" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource PixelFont}"/><TextBlock Text="Your adventure. Your pace." FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{Binding LaunchLabel}" Click="OnLaunchGame" IsEnabled="{Binding CanLaunch}" Margin="8,0,7,0" FontSize="12" Padding="12,8"/><Button Content="{Binding ConnectLabel}" Style="{StaticResource Primary}" Click="OnConnect" IsEnabled="{Binding NotBusy}" FontSize="12" Padding="12,8"/></StackPanel>
      </Grid>
      <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="0" Padding="12,8" Margin="0,0,8,13">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="{DynamicResource Mint}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="{Binding ConnectionStatus}" FontSize="12" Foreground="{DynamicResource Mint}"/><TextBlock Text="{Binding ActiveCount, StringFormat={}  ·  {0} active}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
          <Button Grid.Column="1" Content="Session details" Click="OnSessionDetails" FontSize="11" Padding="8,3" MinHeight="26" ToolTip="Game version, folders and recent activity"/>
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="2" x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
        <StackPanel>
          <StackPanel Visibility="{Binding ShowFeatures, Converter={StaticResource Bool}}">
            <Grid Margin="0,0,8,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SectionSubtitle}" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/><Grid Grid.Column="1"><TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search controls · Ctrl+K" AutomationProperties.Name="Search controls"/><TextBlock Text="Search controls…  Ctrl+K" Foreground="{DynamicResource Muted}" FontSize="11" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Grid>
            <ItemsControl x:Name="FeatureDeck" ItemsSource="{Binding VisibleFeatures}" ItemTemplate="{StaticResource FeatureTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource CardWidth}}"/></Style></ItemsControl.ItemContainerStyle></ItemsControl>
            <TextBlock Text="No controls match this search." Foreground="{DynamicResource Muted}" Margin="0,12,0,20"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding VisibleFeatures.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <TextBlock Text="Switch on to arm a control. It applies automatically when ready." FontSize="11" Foreground="{DynamicResource Muted}" Margin="3,4,8,14"/>
          </StackPanel>
            <StackPanel Visibility="{Binding ShowBackups, Converter={StaticResource Bool}}" Margin="0,0,15,0">
              <TextBlock Text="A safe place for your adventure." FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Each backup includes every available save slot, the autosave and the system file. Files are verified with SHA-256." Foreground="{DynamicResource Muted}" Margin="0,10,0,18"/>
              <TextBlock Text="Steam save folder" Style="{StaticResource SmallLabel}"/><TextBlock Text="{Binding SavePath}" Margin="0,5,0,18" FontSize="12"/>
              <Button Content="Create verified backup" HorizontalAlignment="Left" Style="{StaticResource Primary}" Click="OnBackup" Margin="0,0,0,20"/>
              <TextBlock Text="{Binding BackupSummary}" Foreground="{DynamicResource Muted}" Margin="0,0,0,10"/>
              <ItemsControl ItemsSource="{Binding Backups}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Surface}" Padding="14" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Created}" FontWeight="SemiBold"/><TextBlock Text="{Binding Size}" Style="{StaticResource SmallLabel}" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="Restore…" Click="OnRestore"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <TextBlock Text="Restore with the game closed. Current saves are backed up first. Steam Cloud can replace restored files; check its sync prompt before loading." FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,15,0,20"/>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowProfiles, Converter={StaticResource Bool}}" Margin="0,0,15,20">
              <TextBlock Text="Build your own play style." FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Profiles remember target values and hotkeys. Controls always start off. The trainer resolves current structures automatically." Foreground="{DynamicResource Muted}" Margin="0,10,0,20"/>
              <Border Style="{StaticResource Surface}" Margin="0,0,0,14"><StackPanel><TextBlock Text="App updates" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Keep one installation. Updates preserve your profiles, theme and save backups." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,12"/><Button x:Name="AppUpdatesButton" Content="Check for updates" Click="OnAppUpdates" Style="{StaticResource Primary}" HorizontalAlignment="Left"/></StackPanel></Border>
              <Border Style="{StaticResource Surface}"><StackPanel><TextBlock Text="Profile name"/><TextBox x:Name="ProfileName" Text="My adventure" Margin="0,8,0,12"/><StackPanel Orientation="Horizontal"><Button Content="Save profile" Style="{StaticResource Primary}" Click="OnSaveProfile"/><Button Content="Load selected" Click="OnLoadProfile" Margin="9,0,0,0"/></StackPanel><ComboBox x:Name="ProfilePicker" ItemsSource="{Binding ProfileNames}" Margin="0,15,0,0" AutomationProperties.Name="Saved profiles"/></StackPanel></Border>

              <TextBlock Text="Hotkeys" FontSize="17" FontWeight="SemiBold" Margin="0,23,0,7"/><TextBlock Text="Active only while the game or this trainer has focus. F12 always stops all maintenance controls in either window." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,12"/>
              <ItemsControl ItemsSource="{Binding Features}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.HotkeyOptions, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Hotkey}" AutomationProperties.Name="{Binding Title}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowLuck, Converter={StaticResource Bool}}" Margin="0,0,15,20">
              <TextBlock Text="Make every hunt shine." FontSize="23" FontWeight="SemiBold"/>
              <TextBlock Text="Adjust egg and den generation before launching the game. Preview first, apply with Stories 2 closed, then explore a freshly generated area." Foreground="{DynamicResource Muted}" Margin="0,10,0,18"/>
              <Border Background="{DynamicResource Selected}" CornerRadius="0" Padding="13" Margin="0,0,0,14"><TextBlock Text="{Binding LuckStatus}" Foreground="{DynamicResource Mint}" FontSize="12"/></Border>
              <Border Style="{StaticResource Surface}" BorderBrush="{DynamicResource Gold}" Margin="0,0,0,14"><StackPanel IsEnabled="{Binding NotBusy}">
                <TextBlock Text="Rainbow hunt" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Mint}"/>
                <TextBlock Text="Rainbow egg quality on every solo pull, no empty pulls, and rare dens everywhere they can spawn. Includes solo retreat nests. New egg modes need an in-game check." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,12"/>
                <WrapPanel><Button Content="Apply Rainbow hunt" Click="OnApplyRainbow" Style="{StaticResource Primary}" Margin="0,0,8,0"/><Button Content="Preview only" Click="OnRainbowPreset"/></WrapPanel>
                <TextBlock Text="{Binding RainbowAction}" Foreground="{DynamicResource Mint}" FontSize="12" Margin="0,10,0,0"/>
                <TextBlock Text="Apply installs the preset and verifies the backup. Stories 2 must be closed. Preview only leaves the game unchanged." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,8,0,0"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Surface}"><StackPanel IsEnabled="{Binding NotBusy}">
                <TextBlock Text="Egg quality" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Rainbow mode selects the highest quality even on the first normal-nest pull. It changes egg quality; species still come from that nest's normal pool." FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,8,0,12"/>
                <ComboBox x:Name="EggMode" SelectedIndex="{Binding EggMode}" AutomationProperties.Name="Egg rarity setting"><ComboBoxItem Content="Original egg odds"/><ComboBoxItem Content="Lucky · rare ×3 / super-rare ×10 weight"/><ComboBoxItem Content="Very lucky · rare ×6 / super-rare ×35 weight"/><ComboBoxItem Content="Highest available egg tier"/><ComboBoxItem Content="Rainbow eggs · every solo quality roll"/></ComboBox>
                <CheckBox Content="Set egg-loss chance to zero in eligible solo nests" IsChecked="{Binding NoLostEggs}" Margin="0,16,0,2"/>
                <TextBlock Text="Rainbow mode includes solo retreat nests. Other presets leave retreat nests unchanged. Multiplayer nest tables are unchanged in every mode." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,7,0,0"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Surface}" Margin="0,14,0,0"><StackPanel IsEnabled="{Binding NotBusy}">
                <TextBlock Text="Rare den encounters" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="All rare selects only rare dens. Best unlocked selects super-rare dens where available and rare dens elsewhere. Story-locked super-rare dens stay locked." FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,8,0,12"/>
                <ComboBox x:Name="DenMode" SelectedIndex="{Binding DenMode}" AutomationProperties.Name="Den rarity setting"><ComboBoxItem Content="Original den odds"/><ComboBoxItem Content="More rare dens · rare ×5 / super-rare ×20 weight"/><ComboBoxItem Content="Rare den hunt · rare ×20 / super-rare ×200 weight"/><ComboBoxItem Content="Super-rare hunt · rare ×20 / super-rare ×2000 weight"/><ComboBoxItem Content="All rare dens · 100% rare where eligible"/><ComboBoxItem Content="Best unlocked dens · super-rare, otherwise rare"/></ComboBox>
                <TextBlock Text="Applies to random den generation. Fixed, quest and already generated dens keep their existing results. Visit a freshly generated area after restarting." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,10,0,0"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Surface}" Margin="0,14,0,0"><StackPanel IsEnabled="{Binding NotBusy}">
                <TextBlock Text="Workshop" FontSize="18" FontWeight="SemiBold"/>
                <CheckBox Content="Free crafting · no recipe materials" IsChecked="{Binding FreeCrafting}"/>
                <CheckBox Content="Free forging &amp; upgrades · no Zenny or material points" IsChecked="{Binding FreeForging}"/>
                <CheckBox Content="Gene level requirements become Level 1" IsChecked="{Binding GenesLevelOne}"/>
                <TextBlock Text="Preview and apply with Stories 2 closed. Your egg and den selections are kept. Recipe and story unlocks still apply." FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,7,0,0"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Surface}" BorderBrush="{DynamicResource Line}" Margin="0,14,0,0"><StackPanel>
                <TextBlock Text="Preview &amp; apply" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding LuckPreview}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,10,0,15"/>
                <WrapPanel IsEnabled="{Binding NotBusy}"><Button Content="Preview changes" Click="OnPreviewLuck" Margin="0,0,8,8"/><Button Content="Apply settings" Click="OnInstallLuck" Style="{StaticResource Primary}" Margin="0,0,8,8"/><Button Content="Restore original game data" Tag="Restore" Click="OnInstallLuck" Margin="0,0,0,8"/></WrapPanel>
                <TextBlock Text="The original game archive and your saves are backed up before applying. Restore returns the exact original archive. F12 stops memory controls; restore and restart to remove these settings." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,6,0,0"/>
              </StackPanel></Border>
              <TextBlock Text="Use Egg &amp; gene studio for species selection and Rainbow Genes. Hunt settings change fresh egg quality; the studio edits existing eggs and owned Monsties." FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,16,0,0"/>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowResearch, Converter={StaticResource Bool}}" Margin="0,0,15,20">
              <TextBlock Text="Make your dream Monstie." FontSize="24" FontWeight="SemiBold"/>
              <TextBlock Text="Pick an egg’s species, add an egg to a free carton slot, arrange a 3 × 3 gene board, and place a Rainbow Gene where you want it." Foreground="{DynamicResource Muted}" Margin="0,10,0,20"/>
              <Border Style="{StaticResource Surface}"><StackPanel>
                <TextBlock Text="Egg &amp; gene studio" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Mint}"/>
                <TextBlock Text="Save in-game and close Stories 2. Open a save slot in the studio to edit genes, change an egg’s species or add an egg—even to an empty carton. Every Apply, Add and Undo creates a verified backup. Saves are re-encrypted and checksum-verified automatically." Foreground="{DynamicResource Muted}" Margin="0,10,0,15"/>
                <Button Content="Open egg &amp; gene studio" Click="OnOpenEditor" Style="{StaticResource Primary}" HorizontalAlignment="Left"/>
                <TextBlock Text="Keep Stories 2 closed while editing. Launch it and load the edited slot afterward." Foreground="{DynamicResource Gold}" FontSize="12" Margin="0,12,0,0"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Surface}" Margin="0,14,0,0"><StackPanel>
                <TextBlock Text="Less grinding, more adventure" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Hunt settings now include free crafting, free forging and Level 1 gene requirements. Battle has a damage taken slider. Exploration has a selectable Prayer Pot effect and faster manual gathering." Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
              </StackPanel></Border>
            </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="3" Background="{DynamicResource PeachSurface}" CornerRadius="0" Padding="10,7" Margin="0,8,8,10" Visibility="{Binding HasNotice, Converter={StaticResource Bool}}"><TextBlock Text="{Binding Notice}" FontSize="11" Foreground="{DynamicResource Ink}" MaxHeight="44" TextTrimming="CharacterEllipsis" ToolTip="{Binding Notice}"/></Border>
    </Grid>

  </Grid>
</Window>
